# kotoma config. Copy to ~/.config/kotoma/kotoma.toml and edit.
# `kotoma model use <name>` rewrites the model paths below for you.

# --- ASR (Whisper) ---
# Path to a ggml whisper model. `kotoma model list` shows the options;
# `kotoma model pull <name>` downloads one into models/.
model_path = "models/ggml-small.bin"

# Where the final Markdown transcript is written.
output_path = "transcript.md"

# "en" | "ja" | "auto". Default is "en". Press `l` in TUI to cycle.
# "auto" is prone to hallucinating non-target languages on short segments.
language = "en"

# "default" or a specific device name from `cpal` enumeration.
input_device = "default"

# Optional: mix system audio alongside the mic.
#   "auto"  — auto-detect per OS (WASAPI loopback on Windows, BlackHole-like
#             virtual driver on macOS, `*.monitor` source on Linux).
#   explicit device name — e.g. `loopback:Speakers (Realtek)` on Windows,
#                          `BlackHole 2ch` on macOS,
#                          `alsa_output.xxx.monitor` on Linux.
# Leave unset (or press `m` in the TUI) to capture mic only.
# system_audio_device = "auto"

# Whisper decoding threads.
threads = 4

# Restrict whisper's encoder to each segment's actual length instead of the
# fixed 30 s window — less compute/heat on short utterances, but it degrades
# transcription accuracy noticeably (whisper's encoder assumes the full
# window), so it's off by default. Enable only if you accept that trade-off.
# dynamic_audio_ctx = false

# Segments that don't end a sentence merge with the next one (same language,
# pause below this many ms) into one line, and the full sentence is
# re-translated — big accuracy win for Japanese. 0 disables merging.
# merge_gap_ms = 2000

[vad]
aggressiveness = 2
min_speech_ms = 500
silence_ms = 900
max_segment_ms = 15000

# --- Translator (optional, llama-server subprocess) ---
# Install: `brew install llama.cpp` (provides `llama-server` on PATH)
# Remove or comment out this section to disable translation.
[translator]
binary = "llama-server"
model_path = "models/gemma-4-E4B-it-Q4_K_M.gguf"
port = 8787
# Shared across the server's two direction slots (~2048 each) — plenty for
# the system prompt + recent context pairs, and half the KV memory of 8192.
n_ctx = 4096
max_new_tokens = 512
startup_timeout_secs = 120
